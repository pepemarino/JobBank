@page "/"
@using JobBank.Components.Pages.Home.ViewModels
@using JobBank.Components.Pages.Init

@attribute [Authorize]

@inherits ViewModelBase<IHomeViewModel>

@rendermode InteractiveServer

<PageTitle>@(ViewModel.Title)</PageTitle>

<h1>@(ViewModel.Title)</h1>

<div class="container-fluid mt-4">
    <div class="row g-4">
        <div class="col-lg-6 col-md-12">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3">
                    <div style="height: 400px;">
                        <Chart Config="ViewModel.Config" @ref="ViewModel.JobChart" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-md-12">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3">
                    <div style="height: 400px;">
                        <Chart Config="ViewModel.PieConfig" @ref="ViewModel.DonutCart" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>