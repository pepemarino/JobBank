@page "/About"

<h1>About WORKS Commons</h1>

<div class="continer col-12">
    @if (Info is not null)
    {
        <div class="card shadow-sm border-0 mb-3" style="max-width: 700px;">
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-12">
                        <small class="text-uppercase text-muted d-block">Build</small>
                        <span class="text-primary fw-bold">@Info?.Build</span>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-12">
                        <small class="text-uppercase text-muted d-block">Commit</small>
                        <span class="text-primary fw-bold">@Info?.Commit</span>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-12">
                        <small class="text-uppercase text-muted d-block">Timestamp</small>
                        <span class="text-primary fw-bold">@Info?.Timestamp</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Build information is not available.
        </div>
    }
</div>

@code {
    private BuildInfo? Info;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ILogger<About> Logger { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Info = await Http.GetFromJsonAsync<BuildInfo>("build.json");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load build info");
        }    
    }

    public class BuildInfo
    {
        public string? Build { get; set; }
        public string? Commit { get; set; }
        public string? Timestamp { get; set; }
    }
}
